<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F20D1117"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_script_manager"
            android:textColor="#58A6FF"
            android:textSize="15sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/btnCloseScriptsHeader"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"  android:contentDescription="@string/btn_close"/>
    </LinearLayout>

    <EditText
        android:id="@+id/etScriptName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_script_name" android:inputType="text" android:importantForAutofill="no" />

    <Button
        android:id="@+id/btnSaveScriptAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_save_targets" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="180dp">
        <LinearLayout
            android:id="@+id/layoutScriptsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btnCloseScripts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_close" />
</LinearLayout>
