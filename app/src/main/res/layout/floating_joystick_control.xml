<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp"
    android:layout_height="200dp"
    android:orientation="vertical"
    android:background="#D90D1117"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/handleMoveJoystick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_joystick"
            android:textColor="#58A6FF"
            android:textSize="11sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/btnCloseJoystick"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"  android:importantForAccessibility="no" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="center">

        <View
            android:id="@+id/viewJoystickKnob"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@android:drawable/presence_online" />
    </FrameLayout>

    <Button
        android:id="@+id/btnRecordJoystick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_record_action" />
</LinearLayout>
