<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F20D1117"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_add_action"
        android:textColor="#58A6FF"
        android:textStyle="bold"
        android:gravity="center"
        android:textSize="15sp"
        android:paddingBottom="8dp" />

    <Button android:id="@+id/btnAddClick" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/action_single_click" />
    <Button android:id="@+id/btnAddSwipe" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/action_swipe" />
    <Button android:id="@+id/btnAddTrigger" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/action_template_search" />
    <Button android:id="@+id/btnAddOcr" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/action_text_color" />
    <Button android:id="@+id/btnCancelAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_cancel" />
</LinearLayout>
