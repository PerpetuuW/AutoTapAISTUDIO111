<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:padding="20dp">

    <!-- TOP BAR -->
    <TextView
        android:id="@+id/tv_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_title"
        android:textColor="@color/purple_text_white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_app_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/app_version_tag"
        android:textColor="@color/purple_glow"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/tv_app_title"
        app:layout_constraintStart_toEndOf="@+id/tv_app_title"
        app:layout_constraintTop_toTopOf="@+id/tv_app_title" />

    <TextView
        android:id="@+id/tv_top_shield_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_active"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:text="@string/btn_security"
        android:textColor="#86EFAC"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_app_title"
        app:layout_constraintBottom_toBottomOf="@+id/tv_app_title" />

    <!-- HERO MASTER CIRCLE -->
    <FrameLayout
        android:id="@+id/layout_hero_center"
        android:layout_width="230dp"
        android:layout_height="230dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_app_title"
        app:layout_constraintBottom_toTopOf="@+id/card_system_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.42">

        <View
            android:id="@+id/view_hero_ring_outer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_hero_ring_outer" />

        <View
            android:id="@+id/view_hero_ring_mid"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_hero_ring_mid" />

        <ImageButton
            android:id="@+id/btn_hero_power"
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_hero_power"
            android:src="@drawable/ic_hero_power"
            android:contentDescription="@string/main_switch_desc" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_hero_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/tap_to_launch_hint"
        android:textColor="@color/purple_text_muted"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@+id/layout_hero_center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- [V180.0] КНОПКА ТАРИФОВ: AppCompatButton блокирует кислотный тинт темы MaterialComponents -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_main_pro"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="20dp"
        android:text="PRO Без рекламы / Доступ за рекламу"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:textColor="#EDE9FE"
        android:background="@drawable/bg_card_violet"
        app:layout_constraintTop_toBottomOf="@+id/tv_hero_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- НАУЧНАЯ СИСТЕМНАЯ КАРТОЧКА (INCY AESTHETIC) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_system_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_violet"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_main_pro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_card_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/system_services_header"
            android:textColor="@color/purple_glow"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 1. ДОСТУПНОСТЬ -->
        <FrameLayout
            android:id="@+id/icon_box_acc"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_icon_squircle"
            app:layout_constraintTop_toBottomOf="@+id/tv_card_header"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/badge_tap"
                android:textColor="#C084FC"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/info_box_acc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="@+id/icon_box_acc"
            app:layout_constraintBottom_toBottomOf="@+id/icon_box_acc"
            app:layout_constraintStart_toEndOf="@+id/icon_box_acc"
            app:layout_constraintEnd_toStartOf="@+id/btn_perm_acc">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/service_clicker_title"
                android:textColor="@color/purple_text_white"
                android:textSize="13.5sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/service_clicker_desc"
                android:textColor="@color/purple_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_perm_acc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_action"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="@string/btn_turn_on"
            android:textColor="#C4B5FD"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="@+id/icon_box_acc"
            app:layout_constraintBottom_toBottomOf="@+id/icon_box_acc"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 2. ОВЕРЛЕЙ -->
        <FrameLayout
            android:id="@+id/icon_box_overlay"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_icon_squircle"
            app:layout_constraintTop_toBottomOf="@+id/icon_box_acc"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/badge_hud"
                android:textColor="#C084FC"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/info_box_overlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="@+id/icon_box_overlay"
            app:layout_constraintBottom_toBottomOf="@+id/icon_box_overlay"
            app:layout_constraintStart_toEndOf="@+id/icon_box_overlay"
            app:layout_constraintEnd_toStartOf="@+id/btn_perm_overlay">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overlay_window_title"
                android:textColor="@color/purple_text_white"
                android:textSize="13.5sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overlay_window_desc"
                android:textColor="@color/purple_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_perm_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_action"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="@string/btn_turn_on"
            android:textColor="#C4B5FD"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="@+id/icon_box_overlay"
            app:layout_constraintBottom_toBottomOf="@+id/icon_box_overlay"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 3. СТРИМ 60 FPS -->
        <FrameLayout
            android:id="@+id/icon_box_stream"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_icon_squircle"
            app:layout_constraintTop_toBottomOf="@+id/icon_box_overlay"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/badge_60f"
                android:textColor="#C084FC"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/info_box_stream"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="@+id/icon_box_stream"
            app:layout_constraintBottom_toBottomOf="@+id/icon_box_stream"
            app:layout_constraintStart_toEndOf="@+id/icon_box_stream"
            app:layout_constraintEnd_toStartOf="@+id/btn_perm_stream">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/screen_capture_title"
                android:textColor="@color/purple_text_white"
                android:textSize="13.5sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/screen_capture_desc"
                android:textColor="@color/purple_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_perm_stream"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_action"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="@string/btn_start"
            android:textColor="#C4B5FD"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="@+id/icon_box_stream"
            app:layout_constraintBottom_toBottomOf="@+id/icon_box_stream"
            app:layout_constraintEnd_toEndOf="parent" />
    
    <!-- БЛОК АВТОНОМНОГО УПРАВЛЕНИЯ ДАННЫМИ (DATA HUB) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_data_hub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_violet"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/card_system_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_data_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="УПРАВЛЕНИЕ ДАННЫМИ"
            android:textColor="@color/purple_glow"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_data_header">

            <Button
                android:id="@+id/btn_main_logs"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#1E1B4B"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:text="ЖУРНАЛ" />

            <Button
                android:id="@+id/btn_main_export"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#312E81"
                android:textColor="#A5B4FC"
                android:textSize="10sp"
                android:textStyle="bold"
                android:text="ЭКСПОРТ" />

            <Button
                android:id="@+id/btn_main_import"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="#14532D"
                android:textColor="#86EFAC"
                android:textSize="10sp"
                android:textStyle="bold"
                android:text="ИМПОРТ" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

        <!-- FLOATING BOTTOM NAVIGATION BAR -->
    <LinearLayout
        android:id="@+id/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_bottom_bar"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tab_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_main"
            android:textColor="@color/purple_glow"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tab_demo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:gravity="center"
            android:text="ДЕМО"
            android:textColor="#818CF8"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tab_export"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ЭКСПОРТ"
            android:textColor="#38BDF8"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tab_import"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ИМПОРТ"
            android:textColor="#38BDF8"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tab_logs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_log"
            android:textColor="@color/purple_text_muted"
            android:textSize="11.5sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
